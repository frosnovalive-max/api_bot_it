# ============================================================
# IT-служба колледжа — REST API. Шаблон переменных окружения.
# Скопируйте в .env и заполните значения:  cp .env.example .env
# В Docker Compose эти значения задаются через environment/x-env
# и могут быть переопределены в .env рядом с docker-compose.yml.
# ============================================================

# --- Приложение ---
DEBUG=false

# --- База данных ---
# Внутри Docker Compose хост = postgres (имя сервиса), НЕ localhost.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/it_support
DB_ECHO=false

# --- Параметры контейнера PostgreSQL (используются docker-compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=it_support

# --- JWT (аутентификация веб-панели) ---
# Сгенерируйте стойкий секрет:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- API-ключ внутренних сервисов (бот MAX как REST-клиент, X-API-Key) ---
SERVICE_API_KEY=CHANGE_ME_SERVICE_KEY
# ВАЖНО: токены/URL MAX API здесь НЕ нужны. Core API не общается с мессенджером
# напрямую. Токен бота MAX используется ТОЛЬКО в отдельном приложении Бота,
# которое забирает очередь уведомлений через REST (см. README, раздел
# "Интеграция с Ботом").

# --- CORS (список origin через запятую или JSON-массив) ---
CORS_ORIGINS=["*"]
